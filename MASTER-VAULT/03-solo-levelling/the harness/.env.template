# ==============================================================================
# AUTONOMOUS DEV HARNESS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in values.
# Never commit .env to git. This file is safe to commit — it contains no secrets.
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your real API keys and local configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1 — LLM PROVIDER KEYS
# ------------------------------------------------------------------------------
# At least one high-reasoning primary model key (Anthropic or Gemini) is required.
# Keys are routed via LiteLLM proxy (.harness/telemetry/litellm-config.yaml).

ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
GEMINI_API_KEY=               # https://aistudio.google.com/app/apikey
OPENAI_API_KEY=               # https://platform.openai.com/api-keys (optional fallback)
OPENROUTER_API_KEY=           # https://openrouter.ai/keys (optional gateway)

# ------------------------------------------------------------------------------
# SECTION 2 — OBSERVABILITY / LANGFUSE
# ------------------------------------------------------------------------------
# Langfuse LLM telemetry and trace collection (.harness/telemetry/langfuse-config.json).
# For local/offline development without cloud Langfuse, set MOCK_TELEMETRY=true below.

LANGFUSE_PUBLIC_KEY=          # From Langfuse project settings (pk-lf-...)
LANGFUSE_SECRET_KEY=          # From Langfuse project settings (sk-lf-...)
LANGFUSE_HOST=https://cloud.langfuse.com   # Override for self-hosted (e.g., http://localhost:3000)

# ------------------------------------------------------------------------------
# SECTION 3 — DATABASE / MCP SERVERS
# ------------------------------------------------------------------------------
# Connection parameters for MCP tool servers (.harness/mcp/mcp_servers.json).

DB_USER=postgres
DB_PASSWORD=                  # Local dev database password
DB_NAME=dev
CONTEXT7_API_KEY=             # https://context7.com (optional, for docs MCP server)

# ------------------------------------------------------------------------------
# SECTION 4 — HARNESS RUNTIME
# ------------------------------------------------------------------------------
# Core runtime orchestration, security sandbox engine, log level, and spending limits.

HARNESS_ROOT=.                # Absolute path to repo root (auto-set by Taskfile)
HARNESS_SANDBOX_ENGINE=bubblewrap   # Options: bubblewrap, docker, none
HARNESS_LOG_LEVEL=INFO        # Options: DEBUG, INFO, WARNING, ERROR
HARNESS_BUDGET_USD_SESSION=5.00     # Maximum spend per session before hard abort
HARNESS_BUDGET_USD_DAILY=50.00      # Daily safety cap across all agent runs
HARNESS_ARCHETYPE=C1_ProductEngineering # Default archetype: C1, C2, C3, C4, C5, C6

# ------------------------------------------------------------------------------
# SECTION 5 — LOCAL DEV / OFFLINE MODE
# ------------------------------------------------------------------------------
# Mock telemetry daemon settings for air-gapped / keyless testing (scripts/mock_telemetry_daemon.py).

MOCK_TELEMETRY=false          # Set true to use mock_telemetry_daemon instead of real Langfuse
MOCK_TELEMETRY_PORT=4318      # Port for local OTel collector mock (/v1/traces)
MOCK_LANGFUSE_PORT=3000       # Port for local Langfuse ingestion mock (/api/public/ingestion)

# ==============================================================================
# VARIABLE CLASSIFICATION & DEPENDENCY MATRIX
# ==============================================================================
#
# REQUIRED (Online Mode):
#   - ANTHROPIC_API_KEY or GEMINI_API_KEY (at least one primary LLM provider)
#   - LANGFUSE_PUBLIC_KEY & LANGFUSE_SECRET_KEY (when MOCK_TELEMETRY=false)
#   - HARNESS_ROOT, HARNESS_SANDBOX_ENGINE, HARNESS_BUDGET_USD_SESSION, HARNESS_BUDGET_USD_DAILY
#
# REQUIRED (Offline / Mock Mode — MOCK_TELEMETRY=true):
#   - HARNESS_ROOT, HARNESS_SANDBOX_ENGINE
#   - MOCK_TELEMETRY=true
#   - MOCK_TELEMETRY_PORT, MOCK_LANGFUSE_PORT
#   (LLM keys and Langfuse keys can remain empty if local LLM or mocks are used)
#
# OPTIONAL:
#   - OPENAI_API_KEY (fallback tier in LiteLLM router)
#   - OPENROUTER_API_KEY (alternative gateway)
#   - LANGFUSE_HOST (defaults to https://cloud.langfuse.com)
#   - CONTEXT7_API_KEY (enables Upstash Context7 documentation retrieval MCP)
#   - DB_USER, DB_PASSWORD, DB_NAME (required only if postgres_readonly MCP is active)
#   - HARNESS_LOG_LEVEL (defaults to INFO)
#   - HARNESS_ARCHETYPE (defaults to C1_ProductEngineering)
# ==============================================================================
